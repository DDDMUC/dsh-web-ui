{
  "// purpose": "Type-checks the test files without emitting them into lib/. The main tsconfig excludes *.test.ts so the build stays clean; this project is standalone (no composite/references) because tests only touch the pure modules (affinity/treats/persist/state) plus vitest.",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.test.tsbuildinfo",
    "paths": {
      "@deepseek-ai/cordis": ["/Users/zcl/.dsh/source/current/vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session": ["/Users/zcl/.dsh/source/current/packages/core/session/lib/types/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "src/affinity.ts",
    "src/treats.ts",
    "src/persist.ts",
    "src/state.ts",
    "tests/**/*.spec.ts"
  ]
}
